    #I_0 = 0.95e-4  # GeV^-1 cm^-2 s^-1 sr^-1 #unresolved IGRB fit
    #gamma = 2.31
    #E_cut = 279.0  # GeV
    #E_0 = 0.1      # 100 MeV = 0.1 GeV


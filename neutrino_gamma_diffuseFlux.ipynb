    (0.001, 0.05),  # Resolves VHE / PeV local CMB horizon
    (0.05, 0.5),  # Resolves 1-10 TeV EBL cutoff
    (0.5, 1.5),  # Resolves peak cosmic star formation
    (1.5, 4.0),  # Deep universe, optically thin for Fermi-LAT band
]

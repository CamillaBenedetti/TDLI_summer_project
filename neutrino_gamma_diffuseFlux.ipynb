    linestyle="--",
    lw=2.2,
    label=r"Cascade IC Component ($e^\pm + \gamma_{\mathrm{CMB}}$)",
)
plt.plot(
    E_gamma_grid,
    E_gamma_grid**2 * phi_total_observed,
    color="crimson",
    lw=2.5,
    label=r"Total Observed $\gamma$ (Direct + Cascade)",

# Ackermann Model A Total EGB (4*pi all-sky)
# Prefactor: 1.48e-7 [cm^-2 s^-1 sr^-1] * (gamma - 1) / E_0_GeV
C_0 = 1.48e-7 * (2.31 - 1.0) / 0.1  # GeV^-1 cm^-2 s^-1 sr^-1
dNdE_fit_allsky = (
    C_0
    * (E_grid / 0.1) ** (-2.31)
    * np.exp(-E_grid / 362.0)
)
